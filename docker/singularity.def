Bootstrap: docker
From: pytorch/pytorch:2.9.1-cuda13.0-cudnn9-runtime

%environment
    export DEBIAN_FRONTEND=noninteractive

%files
    requirements.txt /groundgan/requirements.txt
    requirements2.txt /groundgan/requirements2.txt
    requirements-dev.txt /groundgan/requirements-dev.txt
    src /groundgan/src
    arboreto.patch /groundgan/arboreto.patch

%post
    set -eu

    # Update and upgrade system packages (non-interactive)
    apt-get update \
      && apt-get upgrade -y --no-install-recommends \
      && apt-get install -y git g++ make \
      && apt-get clean \
      && rm -rf /var/lib/apt/lists/*

    # Create working directory
    mkdir -p /groundgan

    # Install Python requirements
    python -m pip install --no-cache-dir --root-user-action ignore -r /groundgan/requirements.txt
    python -m pip install --no-cache-dir --root-user-action ignore --no-build-isolation -r /groundgan/requirements2.txt

    # Install dev requirements (uncomment if needed)
    # python -m pip install --no-cache-dir --root-user-action ignore -r /groundgan/requirements-dev.txt  

    # Cleanup pip cache
    rm -rf /root/.cache/pip || true

    # Patch arboreto bug
    patch /opt/conda/lib/python3.11/site-packages/arboreto/core.py /groundgan/arboreto.patch

%runscript
    # If no args provided, default to --help to match Docker CMD
    if [ "$#" -eq 0 ]; then
      set -- --help
    fi
    exec python /groundgan/src/main.py "$@"

%help
    Singularity image for GRouNdGAN based on pytorch/pytorch:2.9.1-cuda13.0-cudnn9-runtime.
    Provide arguments to run the main.py script, e.g.:
    `singularity run groundgan.sif --train --config gan.cfg`

    Defaults to running:
    `python /groundgan/src/main.py --help`